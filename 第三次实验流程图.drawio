        </mxCell>
        <mxCell id="0jhqvz7dmVWh80fedJ1c-14" value="设定距离阈值r=0.1，若一个第二类点云与当前第一类点云的两个距离都小于r，则记录" style="whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1">
